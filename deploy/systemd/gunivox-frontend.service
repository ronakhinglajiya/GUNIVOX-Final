[Unit]
Description=Gunivox frontend (Next.js)
After=network-online.target gunivox-backend.service
Wants=network-online.target

[Service]
Type=simple
User=gunivox
Group=gunivox
WorkingDirectory=/opt/gunivox/frontend
Environment="NODE_ENV=production" "PORT=3000"
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gunivox-frontend

[Install]
WantedBy=multi-user.target
