# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000

# --- Database (Postgres) ---
DATABASE_URL=postgresql+asyncpg://gunivox:gunivox@localhost:5432/gunivox
DATABASE_URL_SYNC=postgresql+psycopg://gunivox:gunivox@localhost:5432/gunivox

# --- Auth ---
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- Sarvam (STT + TTS) ---
SARVAM_API_KEY=
SARVAM_STT_URL=wss://api.sarvam.ai/speech-to-text/ws
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v2

# --- Vobiz (Telephony) ---
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_BASE_URL=https://api.vobiz.ai
VOBIZ_CALLER_ID=
# Public URL Vobiz reaches (your Cloudflare tunnel hostname).
VOBIZ_PUBLIC_BASE_URL=https://api.gunivox.online    

# --- System prompt (override default if needed) ---
# SYSTEM_PROMPT="..."
